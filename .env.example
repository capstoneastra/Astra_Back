# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 커밋 금지)
# 로컬 기본값(DB)은 compose.yaml 과 같으므로 비워 둬도 됩니다.
# 시연 서버(compose.prod.yaml)에서는 DB_PASSWORD, JWT_SECRET 이 꼭 있어야 합니다. DB_URL 은 compose 가 db 서비스로 바꿔 넣습니다.

DB_URL=jdbc:postgresql://localhost:5432/astra
DB_USERNAME=astra
DB_PASSWORD=astra

# 브라우저에서 API 를 부를 프론트 주소 (BE-A, CORS). 쉼표로 여러 개, http://localhost:* 같은 패턴 가능
# 비워 두면 http://localhost:5173 (Vite 개발 서버). 시연 서버는 프론트 배포 주소를 넣습니다
CORS_ALLOWED_ORIGINS=

# JWT 서명 키: 32바이트 이상 임의 문자열 (BE-A)
JWT_SECRET=

# Claude API 키: 팀 채팅으로 공유받기 (BE-C)
ANTHROPIC_API_KEY=

# 임시 Gemini 테스트 (BE-C). Claude 복귀 시 AI_PROVIDER=anthropic 및 위 키 설정 후 재시작.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 회원가입 인증 메일 SMTP (BE-A). MAIL_HOST 를 비워 두면 메일을 보내지 않고 서버 로그에 인증 코드를 출력합니다.
# 예) Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD 는 앱 비밀번호
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# 시연 날에만 true: 메일을 보낸 뒤 서버 로그에도 인증 코드를 남김 (평소에는 false, 로그를 보는 누구나 인증 가능해짐)
MAIL_LOG_CODE=false

# 시연 서버(compose.prod.yaml) 전용 (BE-A). 빈 값으로 두지 말고 값을 적거나 줄을 지우세요
# (SWAGGER_ENABLED= 처럼 비우면 true/false 로 못 읽어 서버가 뜨지 않음)
# APP_PORT: 밖에서 접속할 포트 / SWAGGER_ENABLED: Swagger 공개 여부 (외부 공개 시 false)
APP_PORT=8080
SWAGGER_ENABLED=true
